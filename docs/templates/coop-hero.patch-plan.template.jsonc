// 合作英雄 PatchPlan v2 骨架。
// 这是 JSONC 文档模板，不能直接交给执行器。
// 复制为 docs/examples/<plan-id>.patch-plan.json，删除注释和不适用操作，
// 替换所有 <PLACEHOLDER>，再运行 --check。不要为了通过 Schema 随意填假 ID。
{
  "$schema": "../schemas/patch-plan-v2.schema.json",
  "formatVersion": 2,
  "id": "<commander>-<hero>-implementation",
  "title": "<指挥官>：加入/修改<英雄>",
  "userSummary": {
    "text": "为<指挥官>新增一名具备完整生命周期的<英雄>。"
  },
  "target": "game-a.core",
  "compatibility": {
    "sc2DataBuild": "B97579",
    "runtimeContract": 2
  },
  "scope": {
    "kind": "commander",
    "commanderId": "<COMMANDER_ID>"
  },
  "isolation": {
    "strategy": "private-clone",
    "owner": {
      "catalog": "Unit",
      "object": "<OFFICIAL_HERO_UNIT>"
    }
  },
  "dependsOn": [],
  "conflictsWith": [],
  "operations": [
    // 1. 新英雄通常从调查过的官方 Unit 建立继承覆盖。
    // 修改已有英雄也保留私有 clone，并显式重连其出生/复活/选择入口；不要直接写官方共享对象。
    {
      "opId": "clone-hero-unit",
      "kind": "catalog.clone",
      "catalog": "Unit",
      "source": "<OFFICIAL_HERO_UNIT>",
      "object": "GameA<Hero>"
    },
    {
      "opId": "clear-hostile-map-boss-attribute",
      "kind": "catalog.set",
      "catalog": "Unit",
      "object": "GameA<Hero>",
      "path": "Attributes[MapBoss]",
      "expect": 1,
      "value": 0
    },
    {
      "opId": "allow-dead-hero-cleanup",
      "kind": "catalog.set",
      "catalog": "Unit",
      "object": "GameA<Hero>",
      "path": "FlagArray[PreventDestroy]",
      "expect": 1,
      "value": 0
    },

    // 2. 主 Actor 优先显式创建为 CActorUnit。
    // 不要在没有核对 XML 类时盲目 clone 官方 Actor。
    {
      "opId": "create-hero-actor",
      "kind": "catalog.create",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "class": "CActorUnit",
      "parent": "GenericUnitStandard"
    },
    {
      "opId": "bind-hero-actor-to-unit",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "@unitName",
      "expect": null,
      "value": "GameA<Hero>"
    },
    {
      "opId": "set-hero-world-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "Model",
      "expect": null,
      "value": "<HERO_MODEL>"
    },
    {
      "opId": "set-hero-build-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "BuildModel",
      "expect": null,
      "value": "<WARP_OR_BIRTH_MODEL>"
    },
    {
      "opId": "set-hero-portrait-actor",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "PortraitActor",
      "expect": null,
      "value": "<PORTRAIT_ACTOR>"
    },
    {
      "opId": "set-hero-portrait-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "PortraitModel",
      "expect": null,
      "value": "<PORTRAIT_MODEL>"
    },
    {
      "opId": "set-hero-unit-icon",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "UnitIcon",
      "expect": null,
      "value": "Assets\\Textures\\<hero-icon>.dds"
    },
    {
      "opId": "set-hero-custom-status-frame",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "CustomUnitStatusFrame",
      "expect": null,
      "value": "<COOP_HERO_STATUS_FRAME>"
    },
    {
      "opId": "enable-hero-custom-status-bar",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "StatusBarOn[Custom]",
      "expect": null,
      "value": 1
    },
    {
      "opId": "suppress-default-unit-status-bar",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "UnitFlags[SuppressDefaultStatusBar]",
      "expect": null,
      "value": 1
    },
    {
      "opId": "set-hero-status-bar-offset",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "BarOffset",
      "expect": null,
      "value": 70
    },
    {
      "opId": "set-hero-status-bar-width",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "BarWidth",
      "expect": null,
      "value": 42
    },
    {
      "opId": "set-hero-minimap-priority",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>",
      "path": "MinimapRenderPriority",
      "expect": null,
      "value": "Hero"
    },

    // 3. 对每个技能补充 Ability、Effect、Behavior、Button 和命令卡操作。
    // 这里不提供虚假的通用 Effect 链；必须按设计模板中的实际引用图生成。
    // 示例：将已调查的 Ability 加到一个稳定索引。
    {
      "opId": "insert-hero-primary-ability",
      "kind": "catalog.insert",
      "catalog": "Unit",
      "object": "GameA<Hero>",
      "path": "AbilArray",
      "index": "<STABLE_ABILITY_INDEX>",
      "attributes": {
        "Link": "<HERO_ABILITY>"
      }
    },

    // 4. 复生信标不要继承另一个英雄的完整复生 Unit。
    {
      "opId": "clone-generic-revival-beacon-unit",
      "kind": "catalog.clone",
      "catalog": "Unit",
      "source": "Beacon_Protoss",
      "object": "GameA<Hero>ReviveBeacon"
    },
    {
      "opId": "set-revival-beacon-name-link",
      "kind": "catalog.set",
      "catalog": "Unit",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "Name",
      "expect": null,
      "value": "Unit/Name/GameA<Hero>ReviveBeacon"
    },
    {
      "opId": "make-revival-beacon-invulnerable",
      "kind": "catalog.set",
      "catalog": "Unit",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "FlagArray[Invulnerable]",
      "expect": null,
      "value": 1
    },
    {
      "opId": "set-revival-beacon-life",
      "kind": "catalog.set",
      "catalog": "Unit",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "LifeMax",
      "expect": null,
      "value": 100
    },
    {
      "opId": "create-revival-beacon-actor",
      "kind": "catalog.create",
      "catalog": "Actor",
      "object": "GameA<Hero>ReviveBeacon",
      "class": "CActorUnit",
      "parent": "GenericUnitStandard"
    },
    {
      "opId": "bind-revival-beacon-actor",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "@unitName",
      "expect": null,
      "value": "GameA<Hero>ReviveBeacon"
    },
    {
      "opId": "set-revival-beacon-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "Model",
      "expect": null,
      "value": "<FACTION_APPROPRIATE_BEACON_MODEL>"
    },
    {
      "opId": "show-revival-progress",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "StatusBarOn[Life]",
      "expect": null,
      "value": 1
    },
    {
      "opId": "set-revival-progress-offset",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "BarOffset",
      "expect": null,
      "value": 80
    },
    {
      "opId": "set-revival-progress-width",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameA<Hero>ReviveBeacon",
      "path": "BarWidth",
      "expect": null,
      "value": 78
    },

    // 5. 本地化。
    {
      "opId": "set-hero-name-zh-cn",
      "kind": "locale.set",
      "locale": "zhCN",
      "key": "Unit/Name/GameA<Hero>",
      "value": "<英雄名称>"
    },
    {
      "opId": "set-hero-name-en-us",
      "kind": "locale.set",
      "locale": "enUS",
      "key": "Unit/Name/GameA<Hero>",
      "value": "<Hero Name>"
    },
    {
      "opId": "set-beacon-name-zh-cn",
      "kind": "locale.set",
      "locale": "zhCN",
      "key": "Unit/Name/GameA<Hero>ReviveBeacon",
      "value": "<英雄>复生信标"
    },
    {
      "opId": "set-beacon-name-en-us",
      "kind": "locale.set",
      "locale": "enUS",
      "key": "Unit/Name/GameA<Hero>ReviveBeacon",
      "value": "<Hero> Revival Beacon"
    },

    // 6. 完整 Galaxy 生命周期模块。
    // source 必须实现：指挥官过滤、Phase 0/1/2/3、初次等待、死亡监听、
    // 新 Unit 重建式复活、信标生命再生、Hero panel 和 init 注册。
    {
      "opId": "write-hero-lifecycle",
      "kind": "galaxy.source",
      "path": "Base.SC2Data/Generated/<Hero>.galaxy",
      "expectSha256": null,
      "source": "<COMPLETE_VALIDATED_GALAXY_SOURCE>",
      "register": {
        "order": 220,
        "init": "GameA_<Hero>Init"
      }
    }
  ]
}
