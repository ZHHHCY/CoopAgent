{
  "$schema": "../schemas/patch-plan-v2.schema.json",
  "formatVersion": 2,
  "id": "artanis-hero-visual-fix",
  "title": "阿塔尼斯英雄：修复复生信标模型与英雄状态条",
  "target": "game-a.core",
  "compatibility": {
    "sc2DataBuild": "B97579",
    "runtimeContract": 2
  },
  "dependsOn": [
    "artanis-hero-unit",
    "artanis-hero-galaxy-array-fix",
    "artanis-hero-revival-beacon",
    "artanis-hero-runtime-spawn-fix"
  ],
  "conflictsWith": [],
  "operations": [
    {
      "opId": "set-beacon-display-name",
      "kind": "catalog.set",
      "catalog": "Unit",
      "object": "GameAArtanisReviveBeacon",
      "path": "Name",
      "expect": null,
      "value": "Unit/Name/GameAArtanisReviveBeacon"
    },
    {
      "opId": "detach-beacon-from-external-actor-parent",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisReviveBeacon",
      "path": "@parent",
      "expect": "AlarakReviveBeacon",
      "value": "GenericUnitStandard"
    },
    {
      "opId": "set-beacon-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisReviveBeacon",
      "path": "Model",
      "expect": null,
      "value": "Alarak_COOP_RespawnBase"
    },
    {
      "opId": "set-beacon-build-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisReviveBeacon",
      "path": "BuildModel",
      "expect": null,
      "value": "Alarak_COOP_RespawnBase"
    },
    {
      "opId": "set-beacon-placement-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisReviveBeacon",
      "path": "PlacementModel",
      "expect": null,
      "value": "Alarak_COOP_RespawnBase"
    },
    {
      "opId": "hide-beacon-default-life-bar",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisReviveBeacon",
      "path": "StatusBarFlags[Life]",
      "expect": null,
      "value": 0
    },
    {
      "opId": "set-hero-normal-portrait-actor",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "PortraitActor",
      "expect": "MutatorArtanisPrimalPortrait",
      "value": "ArtanisEx2Portrait"
    },
    {
      "opId": "set-hero-normal-portrait-model",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "PortraitModel",
      "expect": "MutatorAmonArtanisPortrait",
      "value": "ArtanisEx2Portrait"
    },
    {
      "opId": "set-hero-custom-status-frame",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "CustomUnitStatusFrame",
      "expect": null,
      "value": "Coop_UnitStatus/MutatorAmonHeroUnitShieldedStatusFrameTemplate"
    },
    {
      "opId": "enable-hero-custom-status-bar",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "StatusBarOn[Custom]",
      "expect": null,
      "value": 1
    },
    {
      "opId": "suppress-hero-default-status-bar",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "UnitFlags[SuppressDefaultStatusBar]",
      "expect": null,
      "value": 1
    },
    {
      "opId": "set-hero-status-bar-offset",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "BarOffset",
      "expect": null,
      "value": 70
    },
    {
      "opId": "set-hero-status-bar-width",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "BarWidth",
      "expect": null,
      "value": 42
    },
    {
      "opId": "set-hero-minimap-priority",
      "kind": "catalog.set",
      "catalog": "Actor",
      "object": "GameAArtanisHero",
      "path": "MinimapRenderPriority",
      "expect": null,
      "value": "Hero"
    }
  ]
}
